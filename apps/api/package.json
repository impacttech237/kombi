{
  "name": "@kombi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply kombi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kombi-db --remote"
  },
  "dependencies": {
    "@kombi/shared": "workspace:*",
    "@kombi/fiscal": "workspace:*",
    "@kombi/comptable": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0"
  }
}
